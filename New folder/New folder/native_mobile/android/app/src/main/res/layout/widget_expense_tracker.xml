<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background_dark">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💳 Today's Spend"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_widget_open_dialog"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="+ Custom"
            android:textColor="#06B6D4"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:background="@drawable/widget_chip_bg" />
    </LinearLayout>

    <!-- Running Total Display -->
    <TextView
        android:id="@+id/widget_expense_total_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="₹0.00"
        android:textColor="#06B6D4"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 1-Tap Quick Action Buttons (Logs immediately from widget!) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_widget_quick_50"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+₹50"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_chip_bg" />

        <TextView
            android:id="@+id/btn_widget_quick_100"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+₹100"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_chip_bg" />

        <TextView
            android:id="@+id/btn_widget_quick_add_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:text="+ Log"
            android:textColor="#0B0F17"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#06B6D4" />
    </LinearLayout>
</LinearLayout>
