<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💳 Today's Spend"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_expense_total_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="₹0.00"
        android:textColor="#06B6D4"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_widget_quick_add_expense"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="+ Log Expense"
        android:textColor="#0B0F17"
        android:background="#06B6D4"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
